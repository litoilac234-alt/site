# Copy to cloud host environment variables (Render, Railway, etc.).
# Local XAMPP does not need this file — defaults in api/config.php still work.

# Render: https://your-service.onrender.com
# Railway: https://your-app.up.railway.app
# APP_URL=https://your-service.onrender.com

APP_BASE_PATH=/
MAIL_FROM=peo-monitoring@cagayan.gov.ph

# MySQL (TiDB Serverless on Render free tier, or Railway MySQL):
# MYSQLHOST=gateway01.xxx.prod.aws.tidbcloud.com
# MYSQLPORT=4000
# MYSQLDATABASE=test
# MYSQLUSER=xxxx.root
# MYSQLPASSWORD=your-password
# MYSQL_SSL=1
