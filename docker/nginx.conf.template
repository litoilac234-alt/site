server {
    listen ${PORT};
    server_name _;
    root /var/www/html;
    index index.html;

    client_max_body_size 32M;

    # PHP API under /api/
    location ~ ^/api/(.+\.php)(/.*)?$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/api/$1;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
    }

    location /api/ {
        try_files $uri =404;
    }

    # Uploaded reports / PDFs
    location /storage/ {
        alias /var/www/html/storage/;
        try_files $uri =404;
    }

    # Excel / HTML templates
    location /templates/ {
        alias /var/www/html/templates/;
        try_files $uri =404;
    }

    # Brand images
    location /img/ {
        alias /var/www/html/img/;
        try_files $uri =404;
    }

    # SPA: static files then fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
